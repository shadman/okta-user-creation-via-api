# Okta Configuration
# Copy this file to .env and fill in your actual values

# Your Okta domain (e.g., https://your-company.okta.com)
OKTA_DOMAIN=https://your-company.okta.com

# Your Okta API Token
# Generate this from: Okta Admin Console > Security > API > Tokens
OKTA_API_TOKEN=your_api_token_here

